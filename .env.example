# API
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
AWS_REGION=us-east-1
TABLE_NAME=norte-main
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_ACCESS_KEY_ID=local
AWS_SECRET_ACCESS_KEY=local
# Set PSP_BASE_URL to the sandbox host from the test brief (do not commit real hostnames that include the provider name)
PSP_BASE_URL=https://sandbox.example-psp.co/v1
PSP_PUBLIC_KEY=pub_test_replace_me
PSP_PRIVATE_KEY=prv_test_replace_me
PSP_INTEGRITY_SECRET=test_integrity_replace_me
PSP_EVENTS_SECRET=test_events_replace_me
PRICING_BASE_FEE_CENTS=150000
PRICING_DELIVERY_FEE_CENTS=800000
RESERVATION_TTL_SECONDS=900
CORS_ORIGIN=http://localhost:5173

# Web (Vite)
VITE_API_BASE_URL=http://localhost:3000/api
VITE_PSP_PUBLIC_KEY=pub_test_replace_me
VITE_PSP_TOKENIZATION_URL=https://sandbox.example-psp.co/v1
