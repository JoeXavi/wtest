{
  "name": "norte",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './apps/*' run build",
    "test": "pnpm -r --filter './apps/*' run test",
    "test:cov": "pnpm -r --filter './apps/*' run test:cov",
    "lint": "pnpm -r --filter './apps/*' run lint",
    "typecheck": "pnpm -r --filter './apps/*' run typecheck",
    "dev:api": "pnpm --filter @norte/api start:dev",
    "dev:web": "pnpm --filter @norte/web dev",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:setup": "pnpm --filter @norte/api db:setup",
    "seed": "pnpm --filter @norte/api seed",
    "restock": "pnpm --filter @norte/api restock"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.32.1",
    "@typescript-eslint/parser": "^8.32.1",
    "eslint": "^9.27.0",
    "eslint-config-prettier": "^10.1.5",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3"
  }
}
